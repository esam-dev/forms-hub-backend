# ============================================
# Forms Hub Backend — Environment Variables
# ============================================
# Copy this file to .env and adjust values:
#   cp .env.example .env
# ============================================

# --- Database ---
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/forms_hub?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- JWT ---
# Use a strong, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"
